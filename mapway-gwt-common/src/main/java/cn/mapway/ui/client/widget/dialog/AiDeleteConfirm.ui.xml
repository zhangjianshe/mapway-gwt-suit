<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:buttons="urn:import:cn.mapway.ui.client.widget.buttons"
             xmlns:widget="urn:import:cn.mapway.ui.client.widget">
    <ui:style>
        @eval BACKGROUND-COLOR "var(--color-background)";
        @eval COLOR-WARNING "var(--el-color-warning)";
        @eval COLOR-PRIMARY "var(--el-color-primary)";
        @eval COLOR-TEXT-SUMMARY "var(--color-text-summary)";
        @eval BORDER_RADIUS "var(--border-radius)";


        .card {
            background-color: BACKGROUND-COLOR;
            border: 1px solid BACKGROUND-COLOR;
            border-radius: 8px;
            box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.06);
            padding: 32px 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            color: COLOR-WARNING;
            font-size: 36px;
            text-align: center;
            line-height: 36px;
            margin-bottom: 16px;
        }

        .title {
            font-size: 18px;
            color: COLOR-WARNING;
            line-height: 25px;
            margin-bottom: 8px;
            text-align: center;
        }

        .subtitle {
            font-weight: 400;
            font-size: 14px;
            color: COLOR-TEXT-SUMMARY;
            line-height: 20px;
            margin-bottom: 24px;
            text-align: center;
        }

        .btnRow {
            display: flex;
            justify-content: center;
            gap: 16px;
        }

        .btnDelete {
            border-radius: BORDER_RADIUS;
            width: 80px;
            height: 32px;
            border: 1px solid COLOR-PRIMARY;
            color: COLOR-PRIMARY;
            background: transparent;
            cursor: pointer;
        }

        .btnCancel {
            border-radius: BORDER_RADIUS;
            width: 80px;
            height: 32px;
            border: 1px solid COLOR-TEXT-SUMMARY;
            color: COLOR-TEXT-SUMMARY;
            background: transparent;
            cursor: pointer;
        }
    </ui:style>
    <g:HTMLPanel styleName="{style.card}">
        <widget:FontIcon ui:field="icon" addStyleNames="{style.icon}"/>
        <g:Label ui:field="title" styleName="{style.title}"/>
        <g:Label ui:field="subtitle" styleName="{style.subtitle}">删除后不可恢复</g:Label>
        <g:HTMLPanel styleName="{style.btnRow}">
            <buttons:AiButton ui:field="btnDelete" addStyleNames="{style.btnDelete}">确认</buttons:AiButton>
            <buttons:AiButton ui:field="btnCancel" addStyleNames="{style.btnCancel}">取消</buttons:AiButton>
        </g:HTMLPanel>
    </g:HTMLPanel>
</ui:UiBinder>
