<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder" xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:widget="urn:import:cn.mapway.ui.client.widget">
    <ui:style>
        @eval TXT_COLOR "var(--update-color)";
        .uploader {
            opacity: 0;
            z-index: 3002;
            cursor: pointer;
            background: transparent;
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            overflow: hidden;
        }

        .box {
            margin: 0;
            padding: 0;
        }


        .lb {
            line-height: 28px;
            padding: 0px 3px;
            text-overflow: ellipsis;
            white-space: nowrap;
            overflow: hidden;
            font-size: 20px;
            text-align: center;
            color: TXT_COLOR;
        }


    </ui:style>
    <g:LayoutPanel styleName="image-uploader-box" ui:field="root">
        <g:layer>
            <g:Image ui:field="img"/>
        </g:layer>
        <g:layer>
            <g:Label ui:field="lbTitle" addStyleNames="{style.lb}">选择图片上传</g:Label>
        </g:layer>
        <g:layer left="0" bottom="0" top="0" right="0">
            <g:FormPanel ui:field="form" styleName="image-uploader-band">
                <g:FileUpload ui:field="uploader" name="file" styleName="{style.uploader}"/>
            </g:FormPanel>
        </g:layer>
        <g:layer right="4" top="4" width="24" height="24">
            <widget:FontIcon ui:field="btnClear" title="清空图片"  addStyleNames="image-uploader-icon"/>
        </g:layer>
    </g:LayoutPanel>
</ui:UiBinder>
