<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder" xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:widget="urn:import:cn.mapway.ui.client.widget">
    <ui:style>
        .relative-box {
            position: relative;
            overflow: hidden;
        }
    </ui:style>

    <g:LayoutPanel styleName="image-uploader-box {style.relative-box}" ui:field="root">
        <g:layer>
            <g:Image ui:field="img" title="点击上传更换" />
        </g:layer>

        <g:layer right="4px" top="4px" width="24px" height="24px">
            <widget:FontIcon ui:field="btnClear" title="Clear Image" addStyleNames="image-uploader-icon"/>
        </g:layer>
    </g:LayoutPanel>
</ui:UiBinder>
